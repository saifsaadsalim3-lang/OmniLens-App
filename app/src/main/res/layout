<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- عنوان المنظومة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="منظومة OmniLens Engine v2.0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <!-- زر التقاط الكاميرا الخلفية -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📸 التقاط بالكاميرا الخلفية"
            android:textSize="16sp"
            android:onClick="launchPhotoCamera"
            android:layout_marginBottom="12dp"/>

        <!-- زر تصوير مقطع الفيديو -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎥 تصوير مقطع فيديو موثق"
            android:textSize="16sp"
            android:onClick="launchVideoCamera"
            android:layout_marginBottom="12dp"/>

        <!-- زر التحقق من الدفع المالي والعقود -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💳 التحقق من الدفع والضمان المالي"
            android:textSize="16sp"
            android:onClick="checkPaymentButton"
            android:layout_marginBottom="12dp"/>

        <!-- زر حساب المنصة -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👤 حساب المنصة والإعدادات"
            android:textSize="16sp"
            android:onClick="showAccountDialog"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</ScrollView>
